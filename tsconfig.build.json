{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist"
  },
  // Module-local suites sit under src/, so the build has to drop them
  // explicitly or dist/ ships test files importing vitest, a devDependency.
  "include": ["src/**/*.ts"],
  "exclude": ["src/**/tests/**"]
}
