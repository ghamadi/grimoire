{
  "name": "@ghamadi/grimoire",
  "version": "0.1.0",
  "description": "Authoring and distribution for agent skills",
  "keywords": [
    "agent-skills",
    "skills",
    "ai-agents",
    "claude-code",
    "cli"
  ],
  "homepage": "https://github.com/ghamadi/grimoire#readme",
  "bugs": {
    "url": "https://github.com/ghamadi/grimoire/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghamadi/grimoire.git"
  },
  "license": "MIT",
  "author": "Ghaleb Hamadi",
  "type": "module",
  "bin": {
    "grimoire": "dist/cli.js",
    "grim": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "os": [
    "darwin",
    "linux"
  ],
  "engines": {
    "node": ">=22.18.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsdown",
    "start": "node dist/cli.js",
    "typecheck": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "pnpm trailing-spaces && prettier . --write --ignore-unknown",
    "format:check": "prettier . --check --ignore-unknown && pnpm trailing-spaces:check",
    "trailing-spaces": "git ls-files -co --exclude-standard -z -- '*.md' | xargs -0 perl -pi -e 's/ +$//'",
    "trailing-spaces:check": "git ls-files -co --exclude-standard -z -- '*.md' | xargs -0 perl -lne 'if (/ +$/) { print qq{$ARGV:$.: trailing spaces}; $found = 1 } close ARGV if eof; END { exit $found }'",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "dependencies": {
    "@clack/prompts": "^1.8.1",
    "commander": "^15.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.1",
    "eslint": "^10.8.0",
    "globals": "^17.8.0",
    "prettier": "^3.9.6",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.11"
  }
}
